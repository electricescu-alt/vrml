#VRML V2.0 utf8

NavigationInfo {
  type [ "WALK", "EXAMINE", "FLY", "PLANE" ]
  headlight TRUE
  speed 2
}

# =========================
# PODEA
# Centrul cercului: 0 0 10
# Suprafața podelei: y = -0.75
# =========================

Transform {
  translation 0 -0.80 10
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.2 0.2 0.2
        }
      }
      geometry Box {
        size 20 0.1 20
      }
    }
  ]
}

# =========================
# OBIECT CENTRAL
# =========================

Transform {
  translation 0 0 10
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 1 1
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

