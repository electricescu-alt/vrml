#VRML V2.0 utf8

NavigationInfo {
  type [ "WALK", "EXAMINE", "FLY", "PLANE" ]
  headlight TRUE
  speed 2
}

# OBIECTELE DIN CERC
# Centrul cercului este la 0 0 10

Transform {
  translation 0 0 4
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0 0
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation 4.24 0 5.76
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0.5 0
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation 6 0 10
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 1 0
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation 4.24 0 14.24
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 1 0
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation 0 0 16
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 1 1
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation -4.24 0 14.24
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 0.5 1
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation -6 0 10
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 0 1
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

Transform {
  translation -4.24 0 5.76
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0 1
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}

# OBIECTELE DEASUPRA
# Tot în jurul centrului 0 0 10

Transform {
  translation 0 4 5
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 1 1
        }
      }
      geometry Sphere {
        radius 0.8
      }
    }
  ]
}

Transform {
  translation 5 4 10
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0.8 0
        }
      }
      geometry Sphere {
        radius 0.8
      }
    }
  ]
}

Transform {
  translation 0 4 15
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.8 0.8
        }
      }
      geometry Sphere {
        radius 0.8
      }
    }
  ]
}

Transform {
  translation -5 4 10
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0 1
        }
      }
      geometry Sphere {
        radius 0.8
      }
    }
  ]
}


